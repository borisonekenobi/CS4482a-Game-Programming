    - key: collect_orange_150
      value: "\u0421\u044A\u0431\u0435\u0440\u0438 150 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u0438 \u0433\u044A\u0431\u0438"
    - key: collect_purple_10
      value: "\u0421\u044A\u0431\u0435\u0440\u0438 10 \u043B\u0438\u043B\u0430\u0432\u0438 \u0433\u044A\u0431\u0438"
    - key: collect_purple_100
      value: "\u0421\u044A\u0431\u0435\u0440\u0438 100 \u043B\u0438\u043B\u0430\u0432\u0438 \u0433\u044A\u0431\u0438"
    - key: explore_valley
      value: "\u0418\u0437\u0441\u043B\u0435\u0434\u0432\u0430\u0439 \u0434\u043E\u043B\u0438\u043D\u0430\u0442\u0430"
    - key: find_hidden_notes
      value: "\u041D\u0430\u043C\u0435\u0440\u0438 \u0441\u043A\u0440\u0438\u0442\u0438\u0442\u0435 \u0437\u0430\u043F\u0438\u0441\u043A\u0438"
    - key: "\u041D\u0430\u043C\u0435\u0440\u0438 \u0440\u0443\u0431\u0438\u043D\u0430"
      value: "\u041D\u0430\u043C\u0435\u0440\u0438 \u0440\u0443\u0431\u0438\u043D\u0430"
    - key: save_yourself
      value: "\u0421\u043F\u0430\u0441\u0438 \u0441\u0435!"
    - key: note_1_title
      value: "\u0414\u043E \u0442\u043E\u0437\u0438, \u043A\u043E\u0439\u0442\u043E \u043D\u0430\u043C\u0435\u0440\u0438 \u0442\u0430\u0437\u0438 \u0437\u0430\u043F\u0438\u0441\u043A\u0430"
    - key: note_1_content
      value: "\u041D\u0435 \u0437\u043D\u0430\u043C \u043A\u0430\u043A \u0441\u0438 \u043F\u043E\u043F\u0430\u0434\u043D\u0430\u043B \u0442\u0443\u043A, \u043D\u043E \u0449\u043E\u043C \u0447\u0435\u0442\u0435\u0448 \u0442\u043E\u0432\u0430, \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E \u0441\u0438 \u0442\u043E\u043B\u043A\u043E\u0432\u0430 \u0438\u0437\u0433\u0443\u0431\u0435\u043D, \u043A\u043E\u043B\u043A\u043E\u0442\u043E \u0431\u044F\u0445 \u0438 \u0430\u0437.\n\n\u0412 \u0442\u0430\u0437\u0438 \u0434\u043E\u043B\u0438\u043D\u0430 \u0438\u043C\u0430 \u043C\u043D\u043E\u0433\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u0438 \u043D\u0435\u0449\u0430. \u0426\u0432\u0435\u0442\u044F, \u0433\u044A\u0431\u0438, \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F, \u043A\u0430\u043A\u0432\u0438\u0442\u043E \u043D\u0438\u043A\u043E\u0433\u0430 \u0434\u043E\u0441\u0435\u0433\u0430 \u043D\u0435 \u0441\u044A\u043C \u0432\u0438\u0436\u0434\u0430\u043B (\u043C\u0430\u043A\u0430\u0440 \u0447\u0435 \u0430\u0437 \u043D\u0435 \u0438\u0437\u043B\u0438\u0437\u0430\u043C \u043D\u0430\u0432\u044A\u043D, \u0442\u0430\u043A\u0430 \u0447\u0435 \u043C\u0430\u0439 \u043D\u0435 \u0441\u044A\u043C \u0432\u0438\u0436\u0434\u0430\u043B \u043A\u043E\u0439 \u0437\u043D\u0430\u0435 \u043A\u043E\u043B\u043A\u043E \u043D\u0435\u0449\u0430). \u041D\u0435 \u0433\u0438 \u043F\u043E\u0434\u043C\u0438\u043D\u0430\u0432\u0430\u0439 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A\u0430. \u0412\u0437\u0435\u043C\u0430\u0439 \u043A\u0430\u043A\u0432\u043E\u0442\u043E \u043C\u043E\u0436\u0435\u0448.\n\n\u0417\u0430\u0431\u0435\u043B\u044F\u0437\u0430\u0445, \u0447\u0435 \u0434\u043E\u043B\u0438\u043D\u0430\u0442\u0430 \u0441\u044F\u043A\u0430\u0448 \u0432\u044A\u0437\u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0430\u0432\u0430 \u043E\u043D\u0435\u0437\u0438, \u043A\u043E\u0438\u0442\u043E \u043E\u0431\u0440\u044A\u0449\u0430\u0442 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0430 \u0442\u043E\u0432\u0430, \u043A\u043E\u0435\u0442\u043E \u0438\u043C \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430.\n\n\u0423\u0441\u043F\u0435\u0445. \u0429\u0435 \u0442\u0438 \u0442\u0440\u044F\u0431\u0432\u0430..."
    - key: note_2_title
      value: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u043E\u0442 \u043F\u043E\u043B\u0435\u0442\u043E \u21164"
    - key: note_2_content
      value: "\u0417\u0430\u043F\u043E\u0447\u043D\u0430\u0445 \u0434\u0430 \u0441\u044A\u0431\u0438\u0440\u0430\u043C \u0433\u044A\u0431\u0438\u0442\u0435 \u043D\u0430\u043E\u043A\u043E\u043B\u043E. \u041E\u0442\u043D\u0430\u0447\u0430\u043B\u043E \u0441\u0438 \u043C\u0438\u0441\u043B\u0435\u0445, \u0447\u0435 \u0441\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0440\u0430\u0441\u0438\u0432\u0438 \u043C\u0430\u043B\u043A\u0438 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F, \u043D\u043E \u0437\u0430\u0431\u0435\u043B\u044F\u0437\u0430\u0445 \u043D\u0435\u0449\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E.\n\n\u041A\u043E\u043B\u043A\u043E\u0442\u043E \u043F\u043E\u0432\u0435\u0447\u0435 \u0441\u044A\u0431\u0438\u0440\u0430\u043C, \u0442\u043E\u043B\u043A\u043E\u0432\u0430 \u043F\u043E\u0432\u0435\u0447\u0435 \u0441\u044F\u043A\u0430\u0448 \u043E\u0442\u043A\u0440\u0438\u0432\u0430\u043C.\n\n\u041B\u0438\u043B\u0430\u0432\u0438\u0442\u0435 \u0441\u0430 \u043E\u0441\u043E\u0431\u0435\u043D\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0438. \u0427\u0443\u0434\u044F \u0441\u0435 \u043A\u043E\u043B\u043A\u043E \u043B\u0438 \u0449\u0435 \u0441\u0430 \u043D\u0443\u0436\u043D\u0438, \u0437\u0430 \u0434\u0430 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430 \u043D\u0435\u0447\u0438\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435..."
    - key: note_3_title
      value: "\u041D\u0435\u0449\u043E \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u043E"
    - key: note_3_content
      value: "\u0421\u043D\u043E\u0449\u0438 \u043E\u0442\u043D\u043E\u0432\u043E \u0433\u043E \u0432\u0438\u0434\u044F\u0445. \u0420\u0443\u0431\u0438\u043D, \u043E\u0441\u0442\u0430\u0432\u0435\u043D \u043D\u0430 \u043C\u043E\u0441\u0442\u0430 \u043D\u0430\u0434 \u0435\u0437\u0435\u0440\u043E\u0442\u043E.\n\n\u041E\u043F\u0438\u0442\u0430\u0445 \u0441\u0435 \u0434\u0430 \u0433\u043E \u043D\u0430\u043C\u0435\u0440\u044F \u043F\u0440\u0435\u0437 \u0434\u0435\u043D\u044F, \u043D\u043E \u043D\u0435 \u0431\u0435\u0448\u0435 \u0438 \u0441\u043B\u0435\u0434\u0430 \u043E\u0442 \u043D\u0435\u0433\u043E.\n\n\u0418\u0437\u0433\u043B\u0435\u0436\u0434\u0430, \u0447\u0435 \u0442\u043E\u0432\u0430 \u043D\u0435\u0449\u043E \u0441\u0435 \u043F\u043E\u044F\u0432\u044F\u0432\u0430 \u0441\u0430\u043C\u043E \u0441\u043B\u0435\u0434 \u0437\u0430\u043B\u0435\u0437 \u0441\u043B\u044A\u043D\u0446\u0435. \u041C\u0430\u0439 \u0449\u0435 \u0442\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u0441\u0442\u0430\u043D\u0430 \u0438\u0437\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B \u043D\u0430 \u043D\u043E\u0449\u0442\u0430..."
    - key: note_4_title
      value: "\u041D\u0430\u0439-\u0433\u043E\u043B\u044F\u043C\u043E\u0442\u043E \u043C\u0438 \u043E\u0442\u043A\u0440\u0438\u0442\u0438\u0435"
    - key: note_4_content
      value: "\u041D\u0430\u0439-\u043D\u0430\u043A\u0440\u0430\u044F \u0440\u0430\u0437\u0431\u0440\u0430\u0445!\n\n\u0421\u0442\u0430\u0440\u0430\u0442\u0430 \u043A\u0430\u043C\u0438\u043D\u0430 \u043D\u0435 \u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u043A\u0440\u0430\u0441\u0430. \u041D\u0430\u043C\u0435\u0440\u0438\u0445 \u0441\u0442\u0430\u0440 \u043D\u0430\u0434\u043F\u0438\u0441, \u0441\u043F\u043E\u0440\u0435\u0434 \u043A\u043E\u0439\u0442\u043E \u0442\u044F \u0433\u043E\u0440\u0438 \u0442\u043E\u043B\u043A\u043E\u0432\u0430 \u0441\u0438\u043B\u043D\u043E, \u0447\u0435 \u043C\u043E\u0436\u0435 \u0434\u0430 \u0438\u0437\u0433\u043E\u0440\u0438 \u0432\u0441\u0438\u0447\u043A\u043E, \u0434\u043E\u0440\u0438 \u0441\u043A\u044A\u043F\u043E\u0446\u0435\u043D\u043D\u0438 \u043A\u0430\u043C\u044A\u043D\u0438!\n\n\u041D\u0435 \u0441\u044A\u043C \u0433\u043E \u043F\u0440\u043E\u0431\u0432\u0430\u043B \u043B\u0438\u0447\u043D\u043E. \u0412\u0435\u0447\u0435 \u0442\u0432\u044A\u0440\u0434\u0435 \u043C\u043D\u043E\u0433\u043E \u0441\u044A\u043C \u0441\u0435 \u043F\u0440\u0438\u0432\u044A\u0440\u0437\u0430\u043B \u043A\u044A\u043C \u0441\u043A\u044A\u043F\u043E\u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0438\u0442\u0435 \u0441\u0438.\n\n\u041D\u043E \u0430\u043A\u043E \u0438\u0441\u043A\u0430\u0448 \u0434\u0430 \u043D\u0430\u043F\u0443\u0441\u043D\u0435\u0448 \u0442\u043E\u0432\u0430 \u043C\u044F\u0441\u0442\u043E, \u043C\u043E\u0436\u0435 \u0431\u0438 \u0442\u043E\u0447\u043D\u043E \u0442\u043E\u0432\u0430 \u0442\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0448..."
    - key: note_5_title
      value: "25 \u044E\u043B\u0438"
    - key: note_5_content
      value: "\u0421\u043A\u044A\u043F\u0438 \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u043E,\n\n\u0412\u0435\u0447\u0435 \u0441\u044A\u0431\u0440\u0430\u0445 47 \u043B\u0438\u043B\u0430\u0432\u0438 \u0433\u044A\u0431\u0438.\n\n\u0417\u0430\u0449\u043E 47? \u041D\u044F\u043C\u0430\u043C \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u043D\u0438\u043A\u0430\u043A\u0432\u0430 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0430.\n\n\u0418\u0441\u043A\u0430\u0445 \u0434\u0430 \u0441\u044A\u0431\u0435\u0440\u0430 \u0441\u0430\u043C\u043E 10, \u043D\u043E \u043F\u043E\u0441\u043B\u0435 \u043D\u0430\u043C\u0435\u0440\u0438\u0445 \u043E\u0449\u0435 \u0435\u0434\u043D\u0430, \u0438 \u043E\u0449\u0435 \u0435\u0434\u043D\u0430, \u0438 \u043E\u0449\u0435 \u0435\u0434\u043D\u0430.\n\n\u041C\u0430\u0439 \u0438\u043C\u0430\u043C \u043F\u0440\u043E\u0431\u043B\u0435\u043C. \u041F\u043E\u043D\u0435 \u043D\u0435 \u0441\u0430 \u043E\u0442\u0440\u043E\u0432\u043D\u0438...\n\n\u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E."
    - key: note_6_title
      value: "\u041E\u0449\u0435 \u0435\u0434\u043D\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435"
    - key: note_6_content
      value: "\u041B\u0438\u043B\u0430\u0432\u0438\u0442\u0435 \u0433\u044A\u0431\u0438 \u043D\u0435 \u0441\u0430 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043E\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E \u043D\u0435\u0449\u043E \u0442\u0443\u043A.\n\n\u0417\u0430\u043F\u043E\u0447\u043D\u0430\u0445 \u0434\u0430 \u0437\u0430\u0431\u0435\u043B\u044F\u0437\u0432\u0430\u043C \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u0438 \u0433\u044A\u0431\u0438, \u043A\u043E\u0438\u0442\u043E \u0440\u0430\u0441\u0442\u0430\u0442 \u0432 \u043F\u043E-\u0442\u043E\u043F\u043B\u0438\u0442\u0435 \u0447\u0430\u0441\u0442\u0438 \u043D\u0430 \u0434\u043E\u043B\u0438\u043D\u0430\u0442\u0430.\n\n\u0427\u0443\u0434\u044F \u0441\u0435 \u0434\u0430\u043B\u0438 \u0441\u044A\u0431\u0438\u0440\u0430\u043D\u0435\u0442\u043E \u043D\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u0438 \u0432\u0438\u0434\u043E\u0432\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F \u0435 \u043A\u043B\u044E\u0447\u044A\u0442 \u043A\u044A\u043C \u0440\u0430\u0437\u043A\u0440\u0438\u0432\u0430\u043D\u0435\u0442\u043E \u043D\u0430 \u0432\u0441\u0438\u0447\u043A\u043E, \u043A\u043E\u0435\u0442\u043E \u0442\u043E\u0432\u0430 \u043C\u044F\u0441\u0442\u043E \u043C\u043E\u0436\u0435 \u0434\u0430 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438..."
    - key: note_7_title
      value: "\u041F\u0440\u043E\u0433\u043D\u043E\u0437\u0430 \u0437\u0430 \u0432\u0440\u0435\u043C\u0435\u0442\u043E"
    - key: note_7_content
      value: "\u0412\u0447\u0435\u0440\u0430 \u0432\u0430\u043B\u044F \u0434\u044A\u0436\u0434.\n\n\u0414\u043D\u0435\u0441 \u0432\u0430\u043B\u044F \u0434\u044A\u0436\u0434.\n\n\u041F\u043E\u0434\u043E\u0437\u0438\u0440\u0430\u043C, \u0447\u0435 \u0438 \u0443\u0442\u0440\u0435 \u0449\u0435 \u0432\u0430\u043B\u0438.\n\n\u0420\u0435\u0448\u0438\u0445, \u0447\u0435 \u0434\u043E\u043B\u0438\u043D\u0430\u0442\u0430 \u0438\u043C\u0430 \u0434\u0432\u0430 \u0441\u0435\u0437\u043E\u043D\u0430: \u0434\u044A\u0436\u0434 \u0438 \u043C\u0430\u043B\u043A\u043E \u043F\u043E-\u043C\u0430\u043B\u043A\u043E \u0434\u044A\u0436\u0434.\n\n\u041F\u043E\u043D\u0435 \u0446\u0432\u0435\u0442\u044F\u0442\u0430 \u0438\u0437\u0433\u043B\u0435\u0436\u0434\u0430\u0442 \u0449\u0430\u0441\u0442\u043B\u0438\u0432\u0438!"
    - key: note_8_title
      value: "\u0414\u0435\u043D 23"
    - key: note_8_content
      value: "\u0414\u043E\u0439\u0434\u043E\u0445 \u0442\u0443\u043A \u0432 \u0442\u044A\u0440\u0441\u0435\u043D\u0435 \u043D\u0430 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F. \u041E\u0447\u0430\u043A\u0432\u0430\u0445 \u043F\u043B\u0430\u043D\u0438\u043D\u0438, \u0434\u044A\u0440\u0432\u0435\u0442\u0430 \u0438 \u043C\u043E\u0436\u0435 \u0431\u0438 \u043D\u044F\u043A\u043E\u0435 \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u043C\u044F\u0441\u0442\u043E \u0437\u0430 \u043B\u0430\u0433\u0435\u0440\u0443\u0432\u0430\u043D\u0435.\n\n\u041D\u0435 \u043E\u0447\u0430\u043A\u0432\u0430\u0445 \u0434\u0430 \u043F\u0440\u0435\u043A\u0430\u0440\u0430\u043C \u0442\u0440\u0438 \u0441\u0435\u0434\u043C\u0438\u0446\u0438 \u0432 \u0441\u044A\u0431\u0438\u0440\u0430\u043D\u0435 \u043D\u0430 \u0433\u044A\u0431\u0438.\n\n\u041F\u043E\u043D\u044F\u043A\u043E\u0433\u0430 \u0441\u0435 \u0447\u0443\u0434\u044F \u0434\u0430\u043B\u0438 \u0434\u043E\u043B\u0438\u043D\u0430\u0442\u0430 \u043C\u0435 \u043F\u043E\u0434\u043B\u0430\u0433\u0430 \u043D\u0430 \u0438\u0437\u043F\u0438\u0442\u0430\u043D\u0438\u0435, \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u044A\u043C \u0438\u0437\u0433\u0443\u0431\u0438\u043B \u0440\u0430\u0437\u0441\u044A\u0434\u044A\u043A\u0430 \u0441\u0438.\n\n\u041A\u0430\u043A\u0442\u043E \u0438 \u0434\u0430 \u0435, \u043D\u0435 \u043C\u0438\u0441\u043B\u044F, \u0447\u0435 \u0441\u044A\u043C \u0433\u043E\u0442\u043E\u0432 \u0434\u0430 \u0441\u0438 \u0442\u0440\u044A\u0433\u043D\u0430."
    - key: note_9_title
      value: "\u041E\u0449\u0435 \u043D\u0435\u0449\u043E"
    - key: note_9_content
      value: "\u0422\u043E \u0442\u0435 \u0434\u044A\u0440\u0436\u0438 \u0442\u0443\u043A...\n\n\u0422\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u0433\u043E \u0443\u043D\u0438\u0449\u043E\u0436\u0438\u0448...\n\n\u041F\u0440\u0435\u0434\u0438 \u0442\u043E \u0434\u0430 \u0443\u043D\u0438\u0449\u043E\u0436\u0438 \u0442\u0435\u0431..."
